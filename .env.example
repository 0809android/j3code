# Optional: relay features for source builds.
# K3 Code does not connect to any hosted service by default: with this file copied
# unchanged, every cloud feature stays off. Point these at a relay you run yourself.
# Do not add server-side secrets to this file.

# Your relay. For a self-hosted relay, `infra/relay` deploys update it automatically.
# K3CODE_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# K3CODE_HOSTED_APP_URL=https://app.example.com

# Public, ingest-only mobile OpenTelemetry configuration.
# K3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# K3CODE_MOBILE_OTLP_TRACES_DATASET=
# K3CODE_MOBILE_OTLP_TRACES_TOKEN=
